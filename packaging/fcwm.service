[Unit]
Description=FleetCommander (web UI, auto placement, hotkeys, previews)
Documentation=file:///usr/share/doc/fcwm/README.md
# Runs with the graphical session (Plasma) and ends with it – on exit fcwm unloads
# its KWin scripts and releases the global shortcuts.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/fcwm web
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
